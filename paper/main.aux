\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Dreamer architecture. \emph  {Top — World Model (RSSM):} A CNN encoder produces embedding $e_t$. The GRU updates deterministic belief $h_t$; a Gaussian posterior $q(z_t|h_t,e_t)$ is trained against prior $p(z_t|h_t)$ via a KL penalty. Recurrence feeds $h_{t-1}$ and $a_{t-1}$ back into the GRU each step. \emph  {Bottom — Policy:} State $s_t{=}(h_t,z_t)$ seeds $H{=}15$-step imagined rollouts; actor (REINFORCE) and twin critic ($\lambda $-return) losses are computed purely in latent space — no environment interaction during updates.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:dreamer_arch}{{1}{3}{Dreamer architecture. \emph {Top — World Model (RSSM):} A CNN encoder produces embedding $e_t$. The GRU updates deterministic belief $h_t$; a Gaussian posterior $q(z_t|h_t,e_t)$ is trained against prior $p(z_t|h_t)$ via a KL penalty. Recurrence feeds $h_{t-1}$ and $a_{t-1}$ back into the GRU each step. \emph {Bottom — Policy:} State $s_t{=}(h_t,z_t)$ seeds $H{=}15$-step imagined rollouts; actor (REINFORCE) and twin critic ($\lambda $-return) losses are computed purely in latent space — no environment interaction during updates}{figure.caption.2}{}}
