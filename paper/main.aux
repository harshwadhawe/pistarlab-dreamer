\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces SAC+VAE architecture. \emph  {Top — Phase 1 (Visual Representation):} A $\beta $-VAE ($\beta {=}0.1$) is pre-trained on 30 random-exploration episodes. The encoder maps images to 128-D Gaussian latents; the decoder reconstructs observations for the combined loss. \emph  {Bottom — Phase 2 (Q-Learning):} The encoder is frozen; SAC trains twin Q-networks and an EMA target on $(z_t,a_t,r_t,z_{t+1})$ replay tuples. No temporal model or recurrence — every frame is processed independently.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:sac_arch}{{2}{4}{SAC+VAE architecture. \emph {Top — Phase 1 (Visual Representation):} A $\beta $-VAE ($\beta {=}0.1$) is pre-trained on 30 random-exploration episodes. The encoder maps images to 128-D Gaussian latents; the decoder reconstructs observations for the combined loss. \emph {Bottom — Phase 2 (Q-Learning):} The encoder is frozen; SAC trains twin Q-networks and an EMA target on $(z_t,a_t,r_t,z_{t+1})$ replay tuples. No temporal model or recurrence — every frame is processed independently}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Training curves. \textcolor {dreamerblue}{\textbf  {Dreamer}} (blue) vs.\ \textcolor {sacred}{\textbf  {SAC+VAE}} (red). Shaded region shows raw episode values; solid line is a 5-episode rolling mean. Left: reward vs.\ episodes. Centre: reward vs.\ environment steps. Right: reward vs.\ wall-clock time including all setup costs.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:curves}{{3}{5}{Training curves. \textcolor {dreamerblue}{\textbf {Dreamer}} (blue) vs.\ \textcolor {sacred}{\textbf {SAC+VAE}} (red). Shaded region shows raw episode values; solid line is a 5-episode rolling mean. Left: reward vs.\ episodes. Centre: reward vs.\ environment steps. Right: reward vs.\ wall-clock time including all setup costs}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Survival rate (fraction of max episode length completed) vs.\ episodes. A value of 1.0 indicates a full lap without crashing.}}{5}{figure.caption.5}\protected@file@percent }
